<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="296.0" prefWidth="369.0" spacing="20" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.fastwriting.controller.GameController">
   <Label fx:id="levelLabel" text="Nivel: 1">
      <font>
         <Font size="18.0" />
      </font>
   </Label>
   <Label fx:id="timerLabel" text="Tiempo: 20s">
      <font>
         <Font size="18.0" />
      </font>
   </Label>
    <Label fx:id="wordLabel" text="Palabra">
      <font>
         <Font size="36.0" />
      </font></Label>
   <TextField fx:id="inputTextField" onAction="#onValidate" />
    <Button fx:id="validateButton" onAction="#onValidate" text="Comprobar">
      <font>
         <Font size="18.0" />
      </font></Button>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="40.0" />
    </padding>

</VBox>
