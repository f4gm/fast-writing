<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="700.0" prefWidth="450.0" spacing="60.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.fastwriting.controller.GameController">
    <Label fx:id="levelLabel" text="Nivel: 1" />
    <Label fx:id="timerLabel" text="Tiempo: 20s" />
    <Label fx:id="wordLabel" text="Palabra" />
   <VBox alignment="CENTER" prefHeight="200.0" spacing="10.0">
       <Label fx:id="feedback" />
       <TextField fx:id="inputTextField" />
   </VBox>
    <Button fx:id="validateButton" text="Comprobar" />

    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

</VBox>
