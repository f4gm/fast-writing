<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="com.example.fastwriting.controller.WelcomeController">

    <Label fx:id="welcomeLabel" text="¡Bienvenido a Escritura Rapida!" />
    <Label fx:id="instructionLabel" text="Escribe la palabra antes de que se acabe el tiempo." />
    <Button fx:id="startButton" onAction="#onStart" text="Comenzar" />
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>

</VBox>
