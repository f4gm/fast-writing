<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.fastwriting.controller.WelcomeController">

    <Label text="ESCRITURA RAPIDA" />
    <Label text="Escribi la palabra antes de que se acabe el tiempo." />
    <Button fx:id="btnStart" text="Comenzar" onAction="#onStart" />

</VBox>