<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20" prefWidth="450.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.fastwriting.controller.GameOverController">

    <Label fx:id="gameOverLabel" text="Fin del juego" />
   <Label fx:id="feedbackLabel" text="Te has quedado sin tiempo" />
    <Label fx:id="recordLabel" text="Niveles completados: " />
   <Label fx:id="remainingTimeLabel" text="Tiempo restante: " />
    <Button fx:id="restartButton" onAction="#restartGame" text="Reiniciar el juego" />
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

</VBox>
